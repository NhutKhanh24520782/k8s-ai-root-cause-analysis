# =============================================================================
# Shared Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in the real values locally.
# NEVER commit a populated .env file.
# The .env file is excluded by .gitignore.
#
# Note: most sensitive runtime secrets (database passwords, API keys) will
# ultimately be managed via Kubernetes Secrets or AWS Secrets Manager.
# This file covers values that are shared across local development tooling.
# =============================================================================

# --- AWS configuration (set via AWS CLI or environment; do not hardcode) ---
# AWS_PROFILE=<your-aws-cli-profile>
# AWS_DEFAULT_REGION=ap-southeast-1

# --- Terraform remote-state bucket (must match the bootstrapped S3 bucket) ---
# TF_BACKEND_BUCKET=<globally-unique-state-bucket-name>
# TF_BACKEND_REGION=ap-southeast-1

# --- MLflow tracking (local or remote) ---
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- RCA API (local development) ---
# RCA_API_HOST=0.0.0.0
# RCA_API_PORT=8000

ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
