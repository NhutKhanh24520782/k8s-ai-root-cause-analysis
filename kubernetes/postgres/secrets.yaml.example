# =============================================================================
# Kubernetes Secrets — microservices namespace
# USAGE: Copy this file, fill in base64-encoded values, then apply.
#
#   echo -n "your_value" | base64
#
# DO NOT commit files with real secrets. This file is for reference only.
# Store real secrets in AWS Secrets Manager and sync via External Secrets Operator.
# =============================================================================

---
apiVersion: v1
kind: Secret
metadata:
  name: order-db-secret
  namespace: microservices
type: Opaque
data:
  # echo -n "orders_db" | base64
  POSTGRES_DB: b3JkZXJzX2Ri
  # echo -n "order_user" | base64
  POSTGRES_USER: b3JkZXJfdXNlcg==
  # echo -n "CHANGE_ME" | base64
  POSTGRES_PASSWORD: Q0hBTkdFX01F

---
apiVersion: v1
kind: Secret
metadata:
  name: payment-db-secret
  namespace: microservices
type: Opaque
data:
  # echo -n "payment_db" | base64
  POSTGRES_DB: cGF5bWVudF9kYg==
  # echo -n "payment_user" | base64
  POSTGRES_USER: cGF5bWVudF91c2Vy
  # echo -n "CHANGE_ME" | base64
  POSTGRES_PASSWORD: Q0hBTkdFX01F
